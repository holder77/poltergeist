# Never commit real evidence from a real competition.
evidence/

# Never commit a machine-specific config (IPs, ports, trusted hosts).
poltergeist_config.json

# Never commit Tripwire's or logging_health's own small state files if
# they end up outside evidence/ for any reason.
tripwire_state.json
log_size_tracking.json

# Standard Python junk.
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/
build/
dist/

# Generated by the packaging scripts, not meant to be committed:
# poltergeist.ico is rebuilt fresh by generate_icon.py on every Windows
# build (packaging/windows/build_exe.bat runs it automatically), and
# poltergeist-launch.sh has one specific machine's absolute paths to
# python3/poltergeist.py baked into it by install_linux_shortcut.sh.
packaging/windows/poltergeist.ico
packaging/linux/poltergeist-launch.sh
